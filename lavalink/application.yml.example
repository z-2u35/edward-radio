server:
  address: 0.0.0.0
  port: 2333

lavalink:
  pluginsDir: "./plugins"
  server:
    password: "${LAVALINK_PASSWORD:youshallnotpass}"
    sources:
      youtube: false
      soundcloud: true
      http: true
      local: false
  plugins:
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.2"
      repository: "https://maven.lavalink.dev/releases"

plugins:
  youtube:
    enabled: true
    oauth:
      enabled: true
      # Lần chạy đầu, Lavalink sẽ in URL/code OAuth trong docker logs.
      # Sau khi xác thực, đặt refreshToken vào đây để không phải xác thực lại.
      refreshToken: "${YOUTUBE_REFRESH_TOKEN:}"
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    clients:
      - TV
      - WEB
      - WEBEMBEDDED
      - ANDROID_MUSIC
      - TVHTML5_SIMPLY
